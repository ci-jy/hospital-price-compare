/// One negotiated rate. compare_amount is dollars, or percent of charges when compare_unit = pct_of_charges.
table rate
	lineageTag: 57424504-28d9-548e-8833-66f95807b026

	/// Negotiated rates in the current filter.
	measure 'Rates' = COUNTROWS ( rate )
		formatString: #,0
		lineageTag: 63eb657b-e02d-594e-9fef-398c6b35aefb

	/// Rates with an amount that can be compared within their group.
	measure 'Comparable Rates' = CALCULATE ( COUNTROWS ( rate ), rate[is_comparable] = TRUE () )
		formatString: #,0
		lineageTag: 41323d34-57ba-51df-813a-33bce50b0847

	/// Comparable rates as a share of all rates.
	measure 'Share of Comparable Rates' = DIVIDE ( [Comparable Rates], [Rates] )
		formatString: 0.0%
		lineageTag: 7a80e14a-d59a-572e-ab1b-bf5331ac54f6

	/// Hospitals with at least one comparable rate.
	measure 'Hospitals' = CALCULATE ( DISTINCTCOUNT ( rate[hospital_id] ), rate[is_comparable] = TRUE () )
		formatString: 0
		lineageTag: 659c49b7-3615-5843-827f-cb1fd8221ed2

	/// Median compare amount; blank unless exactly one comparison group is in the filter.
	measure 'Median Negotiated Rate' =
			VAR groups =
			    CALCULATE ( DISTINCTCOUNT ( rate[comparison_group] ), rate[is_comparable] = TRUE () )
			RETURN
			    -- Only defined inside one comparison group: a median over a case rate
			    -- and a percent of charges would mean nothing.
			    IF (
			        groups = 1,
			        CALCULATE ( MEDIAN ( rate[compare_amount] ), rate[is_comparable] = TRUE () )
			    )
		formatString: #,0.00
		lineageTag: b92dd099-9759-50e4-a0ec-201796422612

	/// Median of the comparison group over every hospital and payer in the metro.
	measure 'Metro Median Rate' = CALCULATE ( [Median Negotiated Rate], REMOVEFILTERS ( hospital ), REMOVEFILTERS ( plan ) )
		formatString: #,0.00
		lineageTag: c8190ff7-bb13-540c-ab24-2797b631b3d3

	/// How far the selection's median sits from the metro median of the same group.
	measure 'Spread vs Metro Median' =
			VAR selected = [Median Negotiated Rate]
			VAR metro = [Metro Median Rate]
			RETURN
			    IF ( NOT ISBLANK ( selected ) && metro > 0, selected / metro - 1 )
		formatString: +0%;-0%;0%
		lineageTag: cd7803f7-7d86-5c78-8447-f06e36be5e43

	/// Median of rate / group metro median - 1 over dollar-priced rates; works across codes.
	measure 'Typical Spread vs Metro Median' =
			-- Across groups: the median of each dollar rate's own distance from its
			-- group's metro median (groups with two or more hospitals only).
			CALCULATE ( MEDIAN ( rate[vs_metro_median] ), rate[compare_unit] = "usd" )
		formatString: +0%;-0%;0%
		lineageTag: 37f89c22-4a68-5826-b407-88d50acb0a5a

	/// Rates with any quality flag other than ok.
	measure 'Flagged Rates' = CALCULATE ( [Rates], rate[quality_flag] <> "ok" )
		formatString: #,0
		lineageTag: 9bd0c0ac-6584-58ce-80a9-917bf3bec116

	/// Flagged rates as a share of all rates.
	measure 'Share of Flagged Rates' = DIVIDE ( [Flagged Rates], [Rates] )
		formatString: 0.0%
		lineageTag: 40921d11-4f00-55ae-b74f-7849565b5eab

