		sourceColumn: negotiated_percentage

		annotation SummarizationSetBy = Automatic

	/// Dollars, or percent of charges for percent_of_charges rates. Never mix units.
	column compare_amount
		dataType: double
		formatString: #,0.00
		lineageTag: 9849bc4b-354c-53f3-bc64-299c8dc33c18
		summarizeBy: none
		sourceColumn: compare_amount

		annotation SummarizationSetBy = Automatic

	/// Median compare_amount of the rate's comparison group across the whole metro.
	column group_median
		dataType: double
		formatString: #,0.00
		lineageTag: c168e063-c4ec-5acd-a837-0dd33d28ac19
		summarizeBy: none
		sourceColumn: group_median

		annotation SummarizationSetBy = Automatic

	column group_hospitals
		dataType: int64
		lineageTag: bd7ac7f8-8357-5608-a64d-dbd1f37944a4
		summarizeBy: none
		sourceColumn: group_hospitals

		annotation SummarizationSetBy = Automatic

	/// compare_amount / group_median - 1, only for groups with at least two hospitals.
	column vs_metro_median
		dataType: double
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 7f6705d9-0a10-5594-a31d-119f8f2f932e
		summarizeBy: none
		sourceColumn: vs_metro_median

		annotation SummarizationSetBy = Automatic

	/// The rate has an amount that can be compared within its group.
	column is_comparable
		dataType: boolean
		lineageTag: 8c769134-3d9d-595b-bd94-f390903cc074
		summarizeBy: none
		sourceColumn: is_comparable

		annotation SummarizationSetBy = Automatic

	column quality_flag
		dataType: string
		isHidden
		lineageTag: 63c6c5e6-ac7e-5282-b762-7be33382d1bb
		summarizeBy: none
		sourceColumn: quality_flag

		annotation SummarizationSetBy = Automatic

	partition rate = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(ParquetFolder & "rate.parquet"))
				in
				    Source
